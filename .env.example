# ---- Core ----
# Your public HTTPS URL on Railway, no trailing slash (e.g. https://bookjobs247.up.railway.app
# or your custom domain). Every webhook URL is built from this.
PUBLIC_BASE_URL=
# Railway: reference your Postgres service's DATABASE_URL (works as-is).
DATABASE_URL=sqlite:///./bookjobs247.db
# Long random strings. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_PASSWORD=
# Where operator alerts go (empty UK pool, failed provisioning).
ADMIN_EMAIL=

# ---- Retell (voice agent) ----
RETELL_API_KEY=
# Created by: python scripts/setup_retell.py --voice-us <id> --voice-gb <id>
RETELL_AGENT_ID_US=
RETELL_AGENT_ID_GB=

# ---- Twilio (phone numbers) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURES=true

# ---- Stripe (billing) ----
STRIPE_SECRET_KEY=
# From the webhook endpoint you add in Stripe -> Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT_NAME=agent_minutes
# Created by: python scripts/setup_stripe.py
STRIPE_PRICE_BASE_USD=
STRIPE_PRICE_USAGE_USD=
STRIPE_PRICE_BASE_GBP=
STRIPE_PRICE_USAGE_GBP=

# ---- Push notifications ----
# Created by: python scripts/generate_vapid_keys.py  (never change once live)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# ---- Email (password resets, "your number is ready") ----
POSTMARK_API_TOKEN=
EMAIL_FROM=hello@yourdomain.com
# Or SMTP instead of Postmark:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
